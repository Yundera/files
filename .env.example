# Copy to .env for local development. Never commit .env.

# Host directory to serve. Bind-mounted to DATA_ROOT inside the container.
DATA_HOST_PATH=./DATA

# Host port for the dev server.
HOST_PORT=8080

# Ownership applied to everything the app creates. Match the user that owns your
# data directory: `id -u` and `id -g`.
PUID=1000
PGID=1000

TZ=UTC
