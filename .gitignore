# Go
/files
*.test
*.out

# Frontend
web/node_modules/

# Embedded build output (produced by `vite build`). The placeholder index.html is
# tracked so //go:embed all:dist always compiles on a fresh clone.
/internal/ui/dist/*
!/internal/ui/dist/index.html

# Local, machine-specific config (keep .env.example tracked)
.env

# Runtime data folder (host bind mount)
/DATA/

# Misc
*.log
.DS_Store
CLAUDE.md
